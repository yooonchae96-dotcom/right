# ===================================================================
#  이 파일을 복사해서 .env 로 이름을 바꾸고, 값을 채우세요.
#      복사 명령:  copy .env.example .env
#  .env 는 .gitignore 에 있어 깃허브에 절대 올라가지 않습니다.
#  배포본(Vercel)에서는 이 값들을 Vercel 프로젝트 환경 변수에 넣습니다.
# ===================================================================

# --- 채점 AI (구글 AI 스튜디오에서 발급) ---
GEMINI_API_KEY=

# --- 선생님 계정 / 학교 도메인 ---
# OWNER_EMAIL   : 교사 화면에 들어갈 구글 계정
# ALLOWED_DOMAIN: 학생 계정 주소의 @ 뒷부분. 비워 두면 모든 구글 계정 허용
OWNER_EMAIL=
ALLOWED_DOMAIN=

# --- 파이어베이스 (콘솔 > 프로젝트 설정 > 내 앱 에서 복사) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- 선택 사항 (비워 두면 기본값이 쓰입니다) ---
# GEMINI_MODEL=gemini-3.8-flash
# MAX_SUBMISSIONS=3
# HAKBEON_PATTERN=\d{5}
# TASK_TITLE=인간과 자연의 권리 발표 대본
